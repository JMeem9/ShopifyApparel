{% paginate blog.articles by 5 %}
    <h1 class="text-[33px] text-center py-5 text-slate-950 font-bold"> {{ blog.title }}</h1>
    <div class="flex w-full">
      {% for article in blog.articles %}
        <div>
          {{ article.image | image_url: width: 500 | image_url: height: 380 | image_tag }}
          <h2 class="font-bold text-[20px] text-gray-800">
            <a href="{{ article.url }}" class="font-bold text-[20px] text-gray-800">{{ article.title }}</a>
          </h2>
          {{ article.author }} @ {{ article.created_at }}
          <div>
            {% if article.excerpt.size > 0 %}
              {{ article.excerpt }}
            {% else %}
              <p>{{ article.content | strip_html | truncatewords: 100 }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}
      {{ paginate | default_pagination }}
    {% endif %}
{% endpaginate %}
    