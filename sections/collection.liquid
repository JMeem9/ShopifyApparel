<div class="flex flex-col pt-10 pb-10">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when "heading" %}
        <h2 class="text-[33px] text-{{block.settings.heading_position}} text-slate-950 ">
          {% if block.settings.collection_heading %}
            {{ block.settings.collection_heading }}
          {% else %}
            {{ collection.title }}
          {% endif %}
        </h2>
    {% endcase %}
  {% endfor %}
</div>
<div class="flex flex-wrap">
  {% for product in collection.products %}
    <div id="prod-{{ collection.id }}-{{ product.id }}" class="flex flex-col m-3">
      <a href="{{ product.url | within: collection }}">
        <img
          height=''
          width=''
          src="{{ product.featured_image.src | image_url: width: 315, height:315 }}"
          class="">
      </a>
      <a href="{{ product.url | within: collection }}" class="text-lg pt-2 font-semibold text-slate-700">{{ product.title }}</a>
      {% render 'price', product:product %}
      
      {% for block in section.blocks %}
        {% case block.type %}
          {% when "atc_button" %}
            {% if product.available %}
              {% render 'atc-btn', 
                  collection_id: collection.id, 
                  product_id: product.id, 
                  button_link: block.settings.button_link, 
                  button_text: block.settings.button_text,
                %}
              {% else %}
                <p><strong>sold out</strong></p>
            {% endif %}
        {% endcase %}
      {% endfor %}
      
    </div>
  {% else %}
    <p>No Product Found</p>
  {% endfor %}
</div>



{% schema %}
  {
    "name": "Collection",
    "tag": "section",
    "class": "section my-4",
    "blocks": [
      {
        "type": "heading",
        "name": "Collection heading",
        "limit": 1,
        "settings": [
          {
            "type": "inline_richtext",
            "id": "collection_heading",
            "default": "Spotlight our summer lineup",
            "label": "Collection heading"
          }, {
            "type": "select",
            "id": "heading_position",
            "options": [
              {
                "value": "start",
                "label": "Left"
              }, {
                "value": "center",
                "label": "Center"
              }, {
                "value": "end",
                "label": "Right"
              }
            ],
            "default": "start",
            "label": "Heading Position",
            "info": "select heading position"
          }
        ]
      },{
        "type": "atc_button",
        "name": "Add to Cart",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "button_text",
            "default": "Add to Cart",
            "label": "Button Label"
          }, {
            "type": "url",
            "id": "button_link",
            "label": "Button Link"
          }
        ]
      }, {
        "type": "buttons",
        "name": "Product details",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "pdp_button_text",
            "default": "Show Details",
            "label": "Button Label"
          }, {
            "type": "url",
            "id": "pdp_button_link",
            "label": "Button Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Summer Collection",
        "blocks": [
          {
            "type": "heading"
          }, {
            "type": "buttons"
          }
        ]
      }
    ]
  }
{% endschema %}