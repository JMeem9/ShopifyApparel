<div class="flex flex-col  py-9 pt-[{{ section.settings.padding_top }}px] pb-[{{ section.settings.padding_bottom }}px]">
 
    {% if section.blocks %}
        {% for block in section.blocks %}
          {% case block.type %}
                {% when "row" %}
                  {% if block.settings.image %}
                   {% assign row_img_src =  block.settings.image | image_url: width: 315, height:315 %}
                   {% else %}
                   {% assign row_img_src =  "https://petessential-store.myshopify.com/cdn/shop/files/woman-infront-of-tree-with-berries.jpeg?crop=center&height=315&v=1715786091&width=315" %}
                  {% endif %}
                    <div class="flex my-2 {% if block.settings.media_position == 'right' %}flex-row-reverse{% endif %} {% if block.settings.secondary_background %}bg-zinc-200{% endif %}"> 
                        <img
                            height=''
                            width=''
                            src="{{ row_img_src }}"
                            class="w-1/2 flex items-center">
                        
                        <div class="w-1/2 flex flex-col justify-center items-start px-2">
                            <p class="text-xs py-1"> {{ block.settings.caption }}</p>
                            <h2 class="text-4xl pb-5" > {{ block.settings.heading }} </h2>
                            <p class="text-sm py-3"> {{ block.settings.text_content }}</p>
                            <button class="px-4 py-2 my-5 text-md border border-slate-500">
                                {{ block.settings.button_label }}
                            </button>
                        </div>
                    </div>
          {% endcase %}
        {% endfor %}
      {% endif %}
 
 
    

</div>
{% schema %}
  {
    "name": "Multirow",
    "tag": "section",
    "class": "section my-10",
    "settings": [
       {
        "type": "header",
        "content": "Section Padding"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "padding Bottom",
        "default": 36
      }
    ],
    "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Row Image"
        },
        {
          "type": "text",
          "id": "caption",
          "default": "Caption",
          "label": "Row Caption"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Row",
          "label": "Row Heading"
        },
        {
          "type": "inline_richtext",
          "id": "text_content",
          "default": "Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.",
          "label": "Row Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Url"
        },
        {
        "type": "checkbox",
        "id": "secondary_background",
        "default": false,
        "label": "Show Secondery Background"
      },{
        "type": "select",
        "id": "media_position",
        "options": [
          {
            "value": "left",
            "label": "Left"
          }, {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left",
        "label": "Media Position",
        "info": "select your image position"
      }
      ]
    }
  ],
    "presets": [
      {
        "name": "Multirow",
        "blocks": [ {
              "type": "row"
            }
          ]
      }
    ]
  }
{% endschema %}