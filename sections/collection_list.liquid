<div class="flex flex-col items-center pt-10 pb-10">
  <h2 class="text-[33px] text-center text-slate-950 font-bold "> {% if section.settings.title %}{{ section.settings.title }}
    {% else %}
        {{ "Collection Check" }}
  {% endif %}</h2>   
</div>

<div>
  <ul class="flex justify-between">
    {% if section.blocks %}
      {% for block in section.blocks %}
        {% case block.type %}
            {% when "featured_collection" %}
            {% render 'featured_collection', collection: block.settings.collection %}
        {% endcase %}
      {% endfor %}
    {% endif %}
  </ul>
</div>

{% schema %}
    {
      "name": "Collection List",
      "tag": "section",
      "class": "section my-10",
      "settings": [
            {
            "type": "inline_richtext",
            "id": "title",
            "default": "Collections",
            "label": "Heading"
            }
        ],
      "blocks": [
        {
          "type": "featured_collection",
          "name": "Featured collection",
          "settings": [
            {
              "type": "collection",
              "id": "collection",
              "label": "Select Collection"
            }
          ]
        }
      ],
      "presets": [
        {
          "name": "Collection List",
          "blocks": [ {
              "type": "featured_collection"
            }
          ]
        }
      ]
    }
    {% endschema %}